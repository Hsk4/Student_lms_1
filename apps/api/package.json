    "express": "^5",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "postgres": "^3.4.7",
    "svix": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3"
