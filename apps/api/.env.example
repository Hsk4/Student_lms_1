# Copy to apps/api/.env and fill in. Never commit real values.
PORT=4000

# Pooled connection for the API; unpooled for drizzle-kit migrate.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk backend
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_CLOCK_SKEW_MS=5000

# CORS: the production web origin (http://localhost:3000 and the Capacitor
# origins are always allowed).
WEB_ORIGIN=

# Tests only: the throwaway database used by vitest.
TEST_DATABASE_URL=
