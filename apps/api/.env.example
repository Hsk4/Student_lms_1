# Copy to apps/api/.env and fill in. Never commit real values.
PORT=4000

# Pooled connection for the API; unpooled for drizzle-kit migrate.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Local API authentication: generate a unique random value of at least 32 characters.
# Required in production; never commit the real secret.
AUTH_JWT_SECRET=

# Password recovery email (Resend). Configure all 

# CORS: the production web origin, comma-separated for more than one
# (e.g. https://studentlms-sooty.vercel.app). The Capacitor webview origins
# (https://localhost, capacitor://localhost) are always allowed, and
# http://localhost:3000 is added automatically unless NODE_ENV=production.
WEB_APP_URL=https://studentlms-sooty.vercel.app

# Tests only: the throwaway database used by vitest.
TEST_DATABASE_URL=


RESEND_API_KEY=re_your_actual_api_key
AUTH_EMAIL_FROM=Student LMS <noreply@yourdomain.com>

AUTH_JWT_SECRET=your_long_random_secret_at_least_32_characters