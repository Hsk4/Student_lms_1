# Copy to apps/web/.env.local for development, or let the build read
# apps/web/.env.production for production (Vercel and the APK).
#
# NEXT_PUBLIC_* values are compiled into the bundle, so only public values
# belong here. There is no third-party auth key: the web app talks to our API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production value (also set it in the Vercel project settings):
#   NEXT_PUBLIC_API_URL=https://student-lms-1-g0xa.onrender.com/api/v1
