# Copy to apps/web/.env.local for development, or let the build read
# apps/web/.env.production for production (Vercel and the APK).
# Never commit real values other than the Clerk publishable key, which is public.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

