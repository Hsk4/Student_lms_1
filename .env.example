NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Postgres (Neon or any Postgres 15+). `DATABASE_URL_UNPOOLED` is used by
# drizzle-kit migrations; the app itself reads `DATABASE_URL`.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Screenshot/demo only: lets a `demo_<role>` session cookie resolve to the
# seeded demo user (see lib/auth/demo.ts). Leave empty in real environments.
LMS_DEMO_ROLE=admin


# Postgres (Drizzle). DATABASE_URL is the pooled endpoint the app uses;
# DATABASE_URL_UNPOOLED is used by drizzle-kit for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
