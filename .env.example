# One API, one Postgres database, local email/password auth (JWT bearer token).
# Copy to `.env` (apps/api) / `.env.local` (apps/web). Never commit real values.
#
# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------

# Postgres (Neon or any Postgres 15+). The app reads the pooled URL;
# drizzle-kit uses the direct one for migrations. `DATABASE_URL_POOLED` is
# accepted as an alias where a host provides only a pooled endpoint.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Signs the bearer tokens. Minimum 32 characters; required in production.
# Rotating it invalidates every existing session.
AUTH_JWT_SECRET=""

# Password recovery email (Resend). Leave empty to disable recovery; the route
# then answers with a clear "not configured" error instead of pretending.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""

# Web origin(s) allowed through CORS, comma-separated, no trailing slash or
# path (they are normalised). Localhost and the Capacitor origins are added
# automatically in development; Capacitor origins are always allowed.
WEB_ORIGIN=""
# Where password-reset links point.
WEB_APP_URL=""

# Optional: wildcard matchers for Vercel preview hostnames.
PREVIEW_ORIGIN_PATTERNS=""

# Optional: the initial super admin. Read only by `bun run seed:super-admin`;
# never used at runtime, never committed with real values.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------

# Baked into the bundle at build time. Changing it requires a rebuild (and a new
# APK for Android) — it is not read at runtime.
#   development: http://localhost:4000/api/v1
#   production:  https://student-lms-1-g0xa.onrender.com/api/v1
#   Android emulator against a local API: http://10.0.2.2:4000/api/v1
NEXT_PUBLIC_API_URL=""
